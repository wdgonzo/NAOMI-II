                            "to": "anchor"
                        }
                    ],
                    "consume": ["after"],
                    "note": "Example: court vite (runs quickly) - adverb after verb"
                },
                {
                    "result": "VERBAL",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "VERBAL"
                        },
