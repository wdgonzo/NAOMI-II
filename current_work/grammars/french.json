{
    "metadata": {
        "language": "french",
        "version": "0.1-beta",
        "author": "NAOMI-II",
        "description": "Beta French grammar with gender/number agreement and post-nominal adjectives"
    },

    "order": [
        "adv1",
        "adj2", "adj1",
        "nominal1", "nominal2",
        "verb1",
        "predicate1",
        "clause1", "clause2"
    ],

    "rulesets": {
        "adv1": {
            "description": "Adverb modification (tres vite)",
            "result": "SPECIFIER",
            "rules": [
                {
                    "result": "SPECIFIER",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "SPECIFIER"
                        },
                        "before": [
                            {
                                "type": "SPECIFIER",
                                "quantifier": "one"
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "SPECIFICATION",
                            "from": "before[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: tres vite (very quickly)"
                }
            ]
        },

        "adj1": {
            "description": "Attach determiner to noun with gender/number agreement (le chien, la maison)",
            "result": "NOUN",
            "rules": [
                {
                    "result": "NOUN",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [
                            {
                                "type": "DESCRIPTOR",
                                "quantifier": "one",
                                "agreement": {
                                    "GENDER": "anchor.GENDER",
                                    "NUMBER": "anchor.NUMBER"
                                }
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "DESCRIPTION",
                            "from": "before[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: le chien (the dog) - gender/number must agree"
                }
            ]
        },

        "adj2": {
            "description": "Attach POST-NOMINAL and PRE-NOMINAL adjectives with gender/number agreement (maison blanche, grand chien)",
            "result": "NOUN",
            "rules": [
                {
                    "result": "NOUN",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "DESCRIPTOR",
                                "quantifier": "all",
                                "subtypes": ["POST_NOMINAL"],
                                "agreement": {
                                    "GENDER": "anchor.GENDER",
                                    "NUMBER": "anchor.NUMBER"
                                }
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "DESCRIPTION",
                            "from": "after[*]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["after"],
                    "note": "Example: maison blanche (white house) - adjective AFTER noun with gender/number agreement"
                },
                {
                    "result": "NOUN",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [
                            {
                                "type": "DESCRIPTOR",
                                "quantifier": "all",
                                "subtypes": ["PRE_NOMINAL"],
                                "agreement": {
                                    "GENDER": "anchor.GENDER",
                                    "NUMBER": "anchor.NUMBER"
                                }
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "DESCRIPTION",
                            "from": "before[*]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: grand chien (big dog) - some French adjectives go BEFORE noun (BAGS adjectives: beauty, age, goodness, size)"
                }
            ]
        },

        "nominal1": {
            "description": "Convert noun to nominal",
            "result": "NOMINAL",
            "rules": [
                {
                    "result": "NOMINAL",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [],
                        "after": []
                    },
                    "connections": [],
                    "consume": [],
                    "note": "Simple noun to nominal conversion"
                }
            ]
        },

        "nominal2": {
            "description": "Coordinate nominals (chiens et chats)",
            "result": "NOMINAL",
            "rules": [
                {
                    "result": "NOMINAL",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "COORD"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "COORD",
                                "quantifier": "one",
                                "check_original": true
                            }
                        ]
                    },
                    "connections": [],
                    "consume": ["after"],
                    "note": "Consume duplicate COORD"
                },
                {
                    "result": "NOMINAL",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "COORD"
                        },
                        "before": [
                            {
                                "type": "NOMINAL",
                                "quantifier": "all"
                            }
                        ],
                        "after": [
                            {
                                "type": "NOMINAL",
                                "quantifier": "one"
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "COORDINATION",
                            "from": "before[*]",
                            "to": "anchor"
                        },
                        {
                            "type": "COORDINATION",
                            "from": "after[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before", "after"],
                    "note": "Example: le chien et le chat (the dog and the cat)"
                }
            ]
        },

