{
    "metadata": {
        "language": "german",
        "version": "0.1-beta",
        "author": "NAOMI-II",
        "description": "Beta German grammar with gender/number agreement and pre-nominal adjectives"
    },

    "order": [
        "adv1",
        "adj2", "adj1",
        "nominal1", "nominal2",
        "verb1",
        "predicate1",
        "clause1", "clause2"
    ],

    "rulesets": {
        "adv1": {
            "description": "Build adverbial specifiers recursively (sehr schnell)",
            "result": "SPECIFIER",
            "rules": [
                {
                    "result": "SPECIFIER",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "SPECIFIER"
                        },
                        "before": [
                            {
                                "type": "SPECIFIER",
                                "quantifier": "one"
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "SPECIFICATION",
                            "from": "before[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: sehr schnell -> SPECIFIER(schnell) with child SPECIFIER(sehr)"
                }
            ]
        },

        "adj1": {
            "description": "Attach determiner to noun with gender/number agreement (der Hund, die Katze, das Haus)",
            "result": "NOUN",
            "rules": [
                {
                    "result": "NOUN",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [
                            {
                                "type": "DESCRIPTOR",
                                "quantifier": "one",
                                "agreement": {
                                    "GENDER": "anchor.GENDER",
                                    "NUMBER": "anchor.NUMBER"
                                }
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "DESCRIPTION",
                            "from": "before[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: der Hund (the dog) - gender/number must agree (der=MASC, die=FEM, das=NEUT)"
                }
            ]
        },

        "adj2": {
            "description": "Attach PRE-NOMINAL adjectives to noun with gender/number agreement (grosse Hund, weisse Haus)",
            "result": "NOUN",
            "rules": [
                {
                    "result": "NOUN",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [
                            {
                                "type": "DESCRIPTOR",
                                "quantifier": "all",
                                "subtypes": ["PRE_NOMINAL"],
                                "agreement": {
                                    "GENDER": "anchor.GENDER",
                                    "NUMBER": "anchor.NUMBER"
                                }
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "DESCRIPTION",
                            "from": "before[*]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: grosse Hund (big dog) - adjective BEFORE noun with gender/number agreement"
                }
            ]
        },

        "nominal1": {
            "description": "Convert noun to nominal",
            "result": "NOMINAL",
            "rules": [
                {
                    "result": "NOMINAL",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "NOUN"
                        },
                        "before": [],
                        "after": []
                    },
                    "connections": [],
                    "consume": [],
                    "note": "Simple noun to nominal conversion"
                }
            ]
        },

        "nominal2": {
            "description": "Coordinate nominals (der Hund und die Katze)",
            "result": "NOMINAL",
            "rules": [
                {
                    "result": "NOMINAL",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "COORD"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "COORD",
                                "quantifier": "one",
                                "check_original": true
                            }
                        ]
                    },
                    "connections": [],
                    "consume": ["after"],
                    "note": "Consume duplicate COORD token"
                },
                {
                    "result": "NOMINAL",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "COORD"
                        },
                        "before": [
                            {
                                "type": "NOMINAL",
                                "quantifier": "all"
                            }
                        ],
                        "after": [
                            {
                                "type": "NOMINAL",
                                "quantifier": "one"
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "COORDINATION",
                            "from": "before[*]",
                            "to": "anchor"
                        },
                        {
                            "type": "COORDINATION",
                            "from": "after[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before", "after"],
                    "note": "Example: der Hund und die Katze (the dog and the cat)"
                }
            ]
        },

        "verb1": {
            "description": "Build verbal phrases with adverb modifiers (rennt schnell)",
            "result": "VERBAL",
            "rules": [
                {
                    "result": "VERBAL",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "VERBAL"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "SPECIFIER",
                                "quantifier": "one"
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "SPECIFICATION",
                            "from": "after[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["after"],
                    "note": "Example: rennt schnell (runs quickly) - adverb after verb"
                },
                {
                    "result": "VERBAL",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "VERBAL"
                        },
                        "before": [
                            {
                                "type": "SPECIFIER",
                                "quantifier": "one"
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "SPECIFICATION",
                            "from": "before[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: schnell rennt (quickly runs) - adverb before verb"
                }
            ]
        },

        "predicate1": {
            "description": "Build predicates from verbal + arguments",
            "result": "PREDICATE",
            "rules": [
                {
                    "result": "PREDICATE",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "VERBAL"
                        },
                        "before": [],
                        "after": []
                    },
                    "connections": [],
                    "consume": [],
                    "note": "Intransitive verb becomes predicate (Der Hund rennt)"
                },
                {
                    "result": "PREDICATE",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "VERBAL"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "NOMINAL",
                                "quantifier": "one"
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "OBJECT",
                            "from": "anchor",
                            "to": "after[0]"
                        }
                    ],
                    "consume": ["after"],
                    "note": "Example: jagt die Katze (chases the cat) - transitive with accusative object"
                },
                {
                    "result": "PREDICATE",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "VERBAL"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "DESCRIPTOR",
                                "quantifier": "one"
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "COMPLEMENT",
                            "from": "anchor",
                            "to": "after[0]"
                        }
                    ],
                    "consume": ["after"],
                    "note": "Example: ist gross (is big) - copula with predicate adjective"
                }
            ]
        },

        "clause1": {
            "description": "Build clauses from subject + predicate",
            "result": "CLAUSE",
            "rules": [
                {
                    "result": "CLAUSE",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "PREDICATE"
                        },
                        "before": [
                            {
                                "type": "NOMINAL",
                                "quantifier": "one"
                            }
                        ],
                        "after": []
                    },
                    "connections": [
                        {
                            "type": "SUBJECT",
                            "from": "anchor",
                            "to": "before[0]"
                        }
                    ],
                    "consume": ["before"],
                    "note": "Example: Der Hund rennt (The dog runs) - SVO main clause"
                },
                {
                    "result": "CLAUSE",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "PREDICATE"
                        },
                        "before": [],
                        "after": []
                    },
                    "connections": [],
                    "consume": [],
                    "note": "Imperative: bare predicate becomes clause (Lauf! = Run!)"
                }
            ]
        },

        "clause2": {
            "description": "Coordinate clauses (Der Hund rennt und die Katze schlaeft)",
            "result": "CLAUSE",
            "rules": [
                {
                    "result": "CLAUSE",
                    "recursive": false,
                    "pattern": {
                        "anchor": {
                            "type": "COORD"
                        },
                        "before": [],
                        "after": [
                            {
                                "type": "COORD",
                                "quantifier": "one",
                                "check_original": true
                            }
                        ]
                    },
                    "connections": [],
                    "consume": ["after"],
                    "note": "Consume duplicate COORD token"
                },
                {
                    "result": "CLAUSE",
                    "recursive": true,
                    "pattern": {
                        "anchor": {
                            "type": "COORD"
                        },
                        "before": [
                            {
                                "type": "CLAUSE",
                                "quantifier": "all"
                            }
                        ],
                        "after": [
                            {
                                "type": "CLAUSE",
                                "quantifier": "one"
                            }
                        ]
                    },
                    "connections": [
                        {
                            "type": "COORDINATION",
                            "from": "before[*]",
                            "to": "anchor"
                        },
                        {
                            "type": "COORDINATION",
                            "from": "after[0]",
                            "to": "anchor"
                        }
                    ],
                    "consume": ["before", "after"],
                    "note": "Example: Der Hund rennt und die Katze schlaeft"
                }
            ]
        }
    }
}
